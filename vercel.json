{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "JWT_SECRET": "@jwt_secret",
    "DISCORD_WEBHOOK_WARNS": "@discord_webhook_warns",
    "DISCORD_WEBHOOK_BLACKLIST": "@discord_webhook_blacklist",
    "FRONTEND_URL": "https://landscraftapp-frontend.onrender.com",
    "NODE_ENV": "production"
  }
}
